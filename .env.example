# Local development defaults to deterministic offline specialists. AgentCore
# overrides this with bedrock for the official deployed path.
FOREMAN_MODE=offline
FOREMAN_BEDROCK_MODEL=amazon.nova-pro-v1:0
AWS_REGION=us-east-1

# For a credentialed local Bedrock run, set FOREMAN_MODE=bedrock explicitly.

# Optional absolute overrides for local Kujo checkouts/runtime.
KUJO_REPOS_ROOT=/absolute/path/to/kujo-repos
KUJO_BIN=/absolute/path/to/kujo

# Runtime policy bounds.
FOREMAN_MAX_REPAIR_ITERATIONS=2
FOREMAN_MAX_REPAIR_FILES=3
FOREMAN_MAX_REPAIR_LINES=120
FOREMAN_RUN_TIMEOUT_MS=600000
FOREMAN_NODE_TIMEOUT_MS=360000
FOREMAN_WEB_ORIGIN=http://localhost:4173

# AgentCore containers use a writable ephemeral path instead of the read-only app directory.
FOREMAN_STATE_ROOT=.foreman
