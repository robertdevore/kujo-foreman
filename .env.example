# Official hackathon path: Amazon Bedrock through the Strands TypeScript bridge.
FOREMAN_MODE=bedrock
FOREMAN_BEDROCK_MODEL=global.anthropic.claude-sonnet-4-6
AWS_REGION=us-east-1

# For a deterministic no-cloud rehearsal, set FOREMAN_MODE=offline explicitly.

# Optional absolute overrides for local Kujo checkouts/runtime.
KUJO_REPOS_ROOT=/absolute/path/to/kujo-repos
KUJO_BIN=/absolute/path/to/kujo

# Runtime policy bounds.
FOREMAN_MAX_REPAIR_ITERATIONS=2
FOREMAN_MAX_REPAIR_FILES=3
FOREMAN_MAX_REPAIR_LINES=120
FOREMAN_RUN_TIMEOUT_MS=600000
FOREMAN_NODE_TIMEOUT_MS=360000
FOREMAN_WEB_ORIGIN=http://localhost:4173
